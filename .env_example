# =============================================================================
# PoC-it - Variables de entorno (ejemplo)
# =============================================================================
# Copia este archivo a ".env" y rellena las claves reales.
#
# NOTA: Este proyecto soporta múltiples proveedores directamente, pero la forma
# recomendada para gestionarlos de forma centralizada es usar LiteLLM Proxy.
# =============================================================================

# -----------------------------
# LiteLLM Proxy (recomendado)
# -----------------------------
# URL del proxy (por defecto: http://localhost:4000)
LITELLM_BASE_URL="http://localhost:4000"

# Si configuras auth en el proxy, añade aquí su key/token y envíala desde el cliente
# LITELLM_PROXY_KEY="..."

# Si quieres forzar que NUNCA se llamen proveedores directos y que todo pase por el proxy:
# LITELLM_PROXY_ONLY="1"

# -----------------------------
# Proveedores (si usas LiteLLM proxy, el proxy leerá estas keys)
# -----------------------------
# OpenAI deshabilitado (requiere crédito)
# OPENAI_API_KEY="..."
# OPENAI_ORGANIZATION_ID="..."  # opcional

GROQ_API_KEY="..."
GEMINI_API_KEY="..."
MISTRAL_API_KEY="..."
CEREBRAS_API_KEY="..."
OPENROUTER_API_KEY="..."

# -----------------------------
# Modelos (opcionales: defaults en el código)
# -----------------------------
# OpenAI deshabilitado (requiere crédito)
# OPENAI_MODEL="gpt-4.1-mini"
GEMINI_MODEL="gemini-2.5-flash"
MISTRAL_MODEL="codestral-latest"
CEREBRAS_MODEL="llama-3.3-70b"
OPENROUTER_MODEL="openrouter/free"

# -----------------------------
# Ollama (fallback local opcional)
# -----------------------------
OLLAMA_MODEL="qwen7b:latest"
